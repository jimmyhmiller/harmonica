#!/usr/bin/env bash
# Run a JavaScript program through the Harmonica interpreter.
#
#   ./scripts/harmonica path/to/script.js
#   ./scripts/harmonica -e 'console.log(1 + 2)'
#   echo 'console.log("hi")' | ./scripts/harmonica -
#
# First run compiles harmonica-core and caches the classpath in target/.
# Set HARMONICA_REBUILD=1 to force a recompile.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
INTERP_DIR="$PROJECT_ROOT/harmonica-interpreter"
CORE_CLASSES_DIR="$PROJECT_ROOT/harmonica-core/target/classes"
CLASSES_DIR="$INTERP_DIR/target/classes"
CP_FILE="$INTERP_DIR/target/harmonica-cli.classpath"

cd "$PROJECT_ROOT"

needs_build=0
if [[ ! -f "$CLASSES_DIR/com/jimmyhmiller/harmonica/Cli.class" ]]; then
    needs_build=1
fi
if [[ -n "${HARMONICA_REBUILD:-}" ]]; then
    needs_build=1
fi

if [[ "$needs_build" == "1" ]]; then
    echo "Building harmonica-interpreter..." >&2
    ./mvnw -q -pl harmonica-interpreter -am compile
    ./mvnw -q -pl harmonica-interpreter dependency:build-classpath \
        -Dmdep.outputFile="$CP_FILE" -Dmdep.includeScope=runtime
fi

CP="$CLASSES_DIR:$CORE_CLASSES_DIR"
if [[ -s "$CP_FILE" ]]; then
    CP="$CP:$(cat "$CP_FILE")"
fi

exec java -cp "$CP" com.jimmyhmiller.harmonica.Cli "$@"
